# PostgreSQL connection string
# Matches the default credentials from docker-compose.yml for local development.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/new-school

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Used by Payload media uploads (Cloudflare R2, S3-compatible)
# R2 API token credentials, created under R2 -> Manage API Tokens
S3_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID_HERE
S3_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY_HERE
# R2 bucket name
S3_BUCKET=new-school-media
# R2 S3 API endpoint: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Public base URL files are served from: the bucket's r2.dev URL or a custom domain, no trailing slash
S3_PUBLIC_URL=https://pub-YOUR_HASH.r2.dev
